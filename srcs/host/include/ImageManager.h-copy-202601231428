  struct Layout {
    static constexpr u32 MAXBHCARDS = 4u;
    std::string mName;
    u8 mCellForBHCard[MAXBHCARDS];
    u8 mDefaultCell;
    u8 mMaxCards;
    u8 mLayoutId;

    void addCell(u8 card, u8 cellnum) {
      u32 mincard, maxcard;
      if (card == U8_MAX) { mincard = 0u; maxcard = mMaxCards; }
      else if (card < mMaxCards) { mincard = card; maxcard = card + 1u; }
      else FAIL(ILLEGAL_ARGUMENT);
      
      for (u8 c = mincard; c < maxcard; ++c) {
        mCellForBHCard[c] = cellnum;
      }
    }

    std::string to_repr() const {
      char buf[1024];
      char *cur = buf, *end = buf + sizeof(buf);
      cur += snprintf(cur,end - cur,"<Layout#%d:%s %u[",
                      mLayoutId,
                      mName.c_str(),
                      mDefaultCell);
      for (u32 i = 0u; i < mMaxCards; ++i) {
        if (i) cur += snprintf(cur, end-cur, " ");
        cur += snprintf(cur, end-cur, "%u", mCellForBHCard[i]);
      }
      cur += snprintf(cur,end - cur,"]>");
      return std::string(buf);
    }
  };

  struct Cell {
    U8C mSize;
    //typedef std::pair<U8C,u32> ImagePatch;
    typedef std::vector<u32> ImageVec;
    typedef std::vector<ImageVec> ImageGrid;
    ImageGrid mImageGrid;
    u32 getXY(u32 x, u32 y) const {
      MFM_API_ASSERT(x < mSize.x && y < mSize.y, ILLEGAL_ARGUMENT);
      return mImageGrid[y][x];
    }

    void setXY(u32 x, u32 y, u32 v) {
      MFM_API_ASSERT(x < mSize.x && y < mSize.y, ILLEGAL_ARGUMENT);
      mImageGrid[y][x] = v;
    }

    //    typedef std::unordered_map<U8C,u32> CellCoordToImageNum;
    //    CellCoordToImageNum mCellCoordOverrides;

    static Cell make(U8C size) {
      Cell c;
      c.mSize = size;
      c.mImageGrid = ImageGrid(c.mSize.y,ImageVec(c.mSize.x,0));
      return c;
    }

    void addImage(U8C c, u32 imagenum) {
      u32 minx, maxx;
      if (c.x == U8_MAX) { minx = 0u; maxx = mSize.x; }
      else { minx = c.x; maxx = c.x + 1u; }
      u32 miny, maxy;
      if (c.y == U8_MAX) { miny = 0u; maxy = mSize.y; }
      else { miny = c.y; maxy = c.y + 1u; }

      for (u32 x = minx; x < maxx; ++x)
        for (u32 y = miny; y < maxy; ++y)
          setXY(x,y,imagenum);
    }

    std::string toString() const {
      std::string ret;
      char buff[16];
      for (u32 y = 0u; y < mSize.y; ++y) {
        for (u32 x = 0u; x < mSize.x; ++x) {
          auto res = std::to_chars(buff, buff+sizeof(buff), getXY(x,y));
          if (res.ec == std::errc{})
            ret.append(buff,res.ptr - buff);
          else
            ret.append("EEORORRO");
          ret.append(" ");
        }
        ret.append("\n");
      }
      return ret;
    }
  };

  struct BlackHole; // FORWARD

  struct ImageManager {
    static ImageManager& getTheImageManager() ;

    bool deployTo(BlackHole & bh, u32 layoutnumber) ;

    T6Image& makeT6Image(std::string ikey, u8 imageCode, std::string path) ;
    T6Image& getT6Image(std::string ikey) ;
    T6Image& getT6Image(u32 imagenum) ;
    T6Image* getT6ImageIfAny(u32 imagenum) ;

    typedef std::unordered_map<std::string,u32> IKeyToImageNum;
    IKeyToImageNum mIKeyImageNumMap;

    typedef std::unique_ptr<T6Image> T6ImagePtr;
    typedef std::vector<T6ImagePtr> ImageVector;
    ImageVector mImageVector;
    
    typedef std::unordered_map<std::string,Layout> LayoutNameToLayout;
    LayoutNameToLayout mLayoutMap;

    Layout & makeLayout(std::string name, u8 maxcards, u32 defaultcell) {
      MFM_API_ASSERT(mLayoutMap.count(name) != 0, DUPLICATE_ENTRY);
      MFM_API_ASSERT(maxcards <= Layout::MAXBHCARDS, ILLEGAL_ARGUMENT);

      Layout ret;
      ret.mName = name;
      ret.mDefaultCell = defaultcell;
      ret.mMaxCards = maxcards;
      for (u32 i = 0u; i < Layout::MAXBHCARDS; ++i) 
        ret.mCellForBHCard[i] = U8_MAX; // maxval == default cell

      ret.mLayoutId = mLayoutMap.size() + 1u;      
      return mLayoutMap[name] = ret;
    }

    static void pybindings(py::module & m) {
      {
        py::class_<Layout> l(m,"Layout");
        l.def("addCell", &Layout::addCell,py::call_guard<py::gil_scoped_release>());
        l.def("__repr__", &Layout::to_repr,py::call_guard<py::gil_scoped_release>());
      }
      {
        py::class_<Cell> c(m,"Cell");
        c.def_static("make", &Cell::make,py::call_guard<py::gil_scoped_release>());
        c.def("addImage", &Cell::addImage,py::call_guard<py::gil_scoped_release>());
        c.def("toString", &Cell::toString,py::call_guard<py::gil_scoped_release>());
      }
    }

  private:
    ImageManager(u32 dummy) {
      mImageVector.push_back(NULL);
    }
  };

  struct NSIM { /// urgh non-singleton ImageManager
    NSIM() { }

    ImageManager & g() { return ImageManager::getTheImageManager(); }
    T6Image& makeT6Image(std::string ikey, u8 imageCode, std::string path) {
      return g().makeT6Image(ikey,imageCode,path);
    }
    T6Image& getT6Image(std::string ikey) { return g().getT6Image(ikey); }
    T6Image& getT6Image(u32 num) { return g().getT6Image(num); }
    Layout& makeLayout(std::string name, u8 maxcards, u32 defaultcellid) {
      return g().makeLayout(name,maxcards,defaultcellid);
    }

    static void pybindings(py::module & m) {
      {
        py::class_<NSIM> n(m,"ImageManager");
        n.def(py::init<>());
        n.def("makeT6Image", &NSIM::makeT6Image,
                 py::call_guard<py::gil_scoped_release>(),
                 py::return_value_policy::reference);
        n.def("makeLayout", &NSIM::makeLayout,
                 py::call_guard<py::gil_scoped_release>(),
                 py::return_value_policy::reference);
        n.def("getT6Image",py::overload_cast<std::string>(&NSIM::getT6Image),
                 py::call_guard<py::gil_scoped_release>(),py::return_value_policy::reference);
        n.def("getT6Image",py::overload_cast<u32>(&NSIM::getT6Image),
                 py::call_guard<py::gil_scoped_release>(),py::return_value_policy::reference);
      }
    }
  };

