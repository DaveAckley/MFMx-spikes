# -*- mode: conf-toml; -*-
# Wed Nov 11 03:17:33 2026 Add default and per-image host flags
# Sat Aug  8 09:24:31 2026 Back to one card for construction
# Sun Jul  5 22:46:50 2026 Ditch zot for build speed
# Mon May 11 09:14:21 2026 Resurrect host logging
# Sat May  2 02:00:18 2026 Rename bhcard -> bhchip
# Thu Feb 12 12:23:10 2026 Consider adding multimage host config here
# Sat Feb  7 11:27:45 2026 Rename layout.card.. -> layout.cell..
# Sun Jan 18 08:46:21 2026 First spike at a multi-t6-images config file

[Config]
 activeLayout=ewpandhub
 bindirs = [ "$script_dir/../../../../build_cross/bin", "." ]

[module.AcceptLogging]
  blocks = [BC_LOGBLOCK]

[module.AcceptPHASER]
  blocks = [BC_PHASER]

[module.AcceptACache]
  blocks = [BC_ACACHEBLOCK]

[module.OriginateEWs]
#  blocks = [BC_EWCARS]

[layout.allone]
  bhchips = [2]
#  defaultImage = EWP
  defaultImage = HUB
  cell.all = C1X1_ONE
  #hostModules = [ AcceptLogging ]

[layout.ewpandhub]
  bhchips = [0]
#  bhchips = [1]
#  bhchips = [1,2]
#  bhchips = [3]
#  bhchips = [0,1,2,3]
  defaultImage = EWP
#  cell.all = C1X2_EWP_HUB
#  cell.all = C2X1_EWP_HUB
  cell.all = C2X2_EWP_HUB
  hostModules = [ AcceptLogging, AcceptACache, AcceptPHASER ]

# Two cards joined by their east/west eth-seam (stage 3c): chip 1 lies EAST of
# chip 0, linked by the ETH tiles at NoC0 x = 6,7,10,11 (the QuietBox cabling
# in shared/include/EthSeam.h).  The T6s are idle across the seam until the
# cache loaders learn about it; this checks the wiring and the links.
# Select with  activeLayout=seamtest  in [Config].
[layout.seamtest]
  bhchips = [0,1]
  defaultImage = EWP
  cell.all = C2X2_EWP_HUB
  hostModules = [ AcceptLogging, AcceptACache, AcceptPHASER ]
  ethseams = [ "0:E:1:6,7,10,11" ]

# N/S seam alone (cards 0 above 2): slice 3a.  Links on ETH x = 3,4,12,13.
[layout.seamns]
  bhchips = [0,2]
  defaultImage = EWP
  cell.all = C2X2_EWP_HUB
  hostModules = [ AcceptLogging, AcceptACache, AcceptPHASER ]
  ethseams = [ "0:S:2:3,4,12,13" ]

# The bottom pair (cards 2 and 3, E/W seam), for the seam stall hunt (OPEN_ISSUES
# "seamtest consensus stalls"): the same shape as seamtest but in the other row of the
# 2x2 array.  Legal layouts are 01, 02, 23 and 0123 (an L of three cards is refused,
# ERISC_SEAM_DESIGN.md).  Chip 0 absent, so seed chip 2.
[layout.seam23]
  bhchips = [2,3]
  seedchips = [2]
  defaultImage = EWP
  cell.all = C2X2_EWP_HUB
  hostModules = [ AcceptLogging, AcceptACache, AcceptPHASER ]
  ethseams = [ "2:E:3:6,7,10,11" ]

# The right-hand pair (cards 1 above 3, N/S seam), the fourth legal two-card layout, for the
# seam stall hunt.  Links on ETH x = 3,4,12,13.  Chip 0 absent, so seed chip 1.
[layout.seam13]
  bhchips = [1,3]
  seedchips = [1]
  defaultImage = EWP
  cell.all = C2X2_EWP_HUB
  hostModules = [ AcceptLogging, AcceptACache, AcceptPHASER ]
  ethseams = [ "1:S:3:3,4,12,13" ]

# The 2x2 array (slice 3b): all four cards, four seams (ring 0-1-3-2: no
# 0-3 cable), centre diagonals not yet wired.  Only chip 0 autoseeds, so
# atoms in the other cards have crossed the cables.
[layout.seam4]
  bhchips = [0,1,2,3]
  seedchips = [0]
  defaultImage = EWP
  cell.all = C2X2_EWP_HUB
  hostModules = [ AcceptLogging, AcceptACache, AcceptPHASER ]
  ethseams = [ "0:E:1:6,7,10,11", "2:E:3:6,7,10,11",
               "0:S:2:3,4,12,13", "1:S:3:3,4,12,13" ]

[cell.C1X1_ONE]
  size = [1,1]
  image.all.all = HUB
#  image.all.all = EWP

[cell.C1X2_EWP_HUB]
  size = [1,2]
  fill = EWP
  image.0.1 = HUB

[cell.C2X1_EWP_HUB]
  size = [2,1]
  fill = HUB
  image.1.0 = EWP

[cell.C2X2_EWP_HUB]
  size = [2,2]
  fill = EWP
  image.1.1 = HUB

[image.EWP]
  binfile="ewp.bin"
  hostFlags = 3  # assert_stop_log + no_utag
  code=1
  # takes a loadable physics (mfmxctl --physics / 'physics' command; with
  # none chosen, an empty marker and the compiled-in one): physics/README.md
  physics = true

[image.HUB]
  binfile="hub.bin"
  hostFlags = 7  # assert_stop_log + no_utag + stag_ptrace
  code=2
