# -*- mode: conf-toml; -*-
# Wed Nov 11 03:17:33 2026 Add default and per-image host flags
# Sat Aug  8 09:24:31 2026 Back to one card for construction
# Sun Jul  5 22:46:50 2026 Ditch zot for build speed
# Mon May 11 09:14:21 2026 Resurrect host logging
# Sat May  2 02:00:18 2026 Rename bhcard -> bhchip
# Thu Feb 12 12:23:10 2026 Consider adding multimage host config here
# Sat Feb  7 11:27:45 2026 Rename layout.card.. -> layout.cell..
# Sun Jan 18 08:46:21 2026 First spike at a multi-t6-images config file

[Config]
 activeLayout=ewpandhub
 bindirs = [ "$script_dir/../../../../build_cross/bin", "." ]

[module.AcceptLogging]
  blocks = [BC_LOGBLOCK]

[module.AcceptPHASER]
  blocks = [BC_PHASER]

[module.AcceptACache]
  blocks = [BC_ACACHEBLOCK]

[module.OriginateEWs]
#  blocks = [BC_EWCARS]

[layout.allone]
  bhchips = [2]
#  defaultImage = EWP
  defaultImage = HUB
  cell.all = C1X1_ONE
  #hostModules = [ AcceptLogging ]

[layout.ewpandhub]
  bhchips = [0]
#  bhchips = [1]
#  bhchips = [1,2]
#  bhchips = [3]
#  bhchips = [0,1,2,3]
  defaultImage = EWP
#  cell.all = C1X2_EWP_HUB
#  cell.all = C2X1_EWP_HUB
  cell.all = C2X2_EWP_HUB
  hostModules = [ AcceptLogging, AcceptACache, AcceptPHASER ]

# Two cards joined by their east/west eth-seam (stage 3c): chip 1 lies EAST of
# chip 0, linked by the ETH tiles at NoC0 x = 6,7,10,11 (the QuietBox cabling
# in shared/include/EthSeam.h).  The T6s are idle across the seam until the
# cache loaders learn about it; this checks the wiring and the links.
# Select with  activeLayout=seamtest  in [Config].
[layout.seamtest]
  bhchips = [0,1]
  defaultImage = EWP
  cell.all = C2X2_EWP_HUB
  hostModules = [ AcceptLogging, AcceptACache, AcceptPHASER ]
  ethseams = [ "0:E:1:6,7,10,11" ]

# N/S seam alone (cards 0 above 2): slice 3a.  Links on ETH x = 3,4,12,13.
[layout.seamns]
  bhchips = [0,2]
  defaultImage = EWP
  cell.all = C2X2_EWP_HUB
  hostModules = [ AcceptLogging, AcceptACache, AcceptPHASER ]
  ethseams = [ "0:S:2:3,4,12,13" ]

[cell.C1X1_ONE]
  size = [1,1]
  image.all.all = HUB
#  image.all.all = EWP

[cell.C1X2_EWP_HUB]
  size = [1,2]
  fill = EWP
  image.0.1 = HUB

[cell.C2X1_EWP_HUB]
  size = [2,1]
  fill = HUB
  image.1.0 = EWP

[cell.C2X2_EWP_HUB]
  size = [2,2]
  fill = EWP
  image.1.1 = HUB

[image.EWP]
  binfile="ewp.bin"
  hostFlags = 3  # assert_stop_log + no_utag
  code=1

[image.HUB]
  binfile="hub.bin"
  hostFlags = 7  # assert_stop_log + no_utag + stag_ptrace
  code=2
