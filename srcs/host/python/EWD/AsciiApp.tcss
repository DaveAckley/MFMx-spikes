Screen {
    layout: vertical;
}
Header, Footer {
    height: auto;
}
#horiz {
    width: 1fr;
}

#leftvert {
    layout: grid;
    grid-size: 3;
    grid-rows: 1;
    background: gray 10%;
    height: 1fr;
    width: 9;
    margin: 0;
    padding: 1 1 0 1;
}

#leftvert Button {
    margin: 0 0 0 0;
    padding: 0 0 0 0;
    height: 1;
    max-width: 100w;
}
#ctrvert {
    width: 90;
}
#centrhoriz {
    border: none;
    width: 1fr;
    height: 1;
}
#ascii-animation {
}
AsciiAnimation {
    /* The widget's size is determined by its virtual size. */
    width: 1fr;
    height: 1fr;
    color: magenta;
    height: 1fr; /* Takes up all available vertical space */
    border: solid gray;
    padding: 0;
    margin: 0;
}
