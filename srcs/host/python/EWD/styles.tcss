Screen {
    layout: vertical;
}
Header, Footer {
    height: auto;
}
#horiz {
    width: 1fr;
}

#leftvert {
    background: gray 10%;
    height: 1fr;
    width: 25;
    margin: 0;
    padding: 1 1 0 1;
    border: none;
}

#ctrvert Label {
    height: 1;
    width: 1fr;
}

#leftvert #scrollbuttons {
    layout: grid;
    grid-size: 3;
    grid-rows: 1;
    background: gray 10%;
    height: 6;
    width: 1fr;
    margin: 0;
    padding: 1 1 0 1;
}

#richlog {
    width: 1fr;
    height: 1fr;
    border: none;
}

#runbuttons {
    width: 1fr;
    height: 5;
    border: none;
}

#runcheck {
    border: none;
}

#step {
}

#leftvert Button {
    margin: 0 0 0 0;
    padding: 0 0 0 0;
    height: 1;
    max-width: 100w;
}
#ctrvert {
    width: 1fr;
}
#centrhoriz {
    border: none;
    width: 1fr;
    height: 1;
}
#renderpos {
    max-width: 64;
    background: green 30%;
}
#statsline {
    width: 3fr;
    background: orange 25%;
}
#ascii-animation {
}
AsciiAnimation {
    /* The widget's size is determined by its virtual size. */
    width: 1fr;
    height: 1fr;
    color: magenta;
    height: 1fr; /* Takes up all available vertical space */
    border: solid gray;
    padding: 0;
    margin: 0;
}

MySource {
    border: solid gray;
    padding: 0 1;
    margin: 0 1;
    height: 3;
    width: auto;
    content-align: center middle;
}
MySource.selected {
    border: solid dodgerblue;
    background: #00008b; /* Dark blue */
}
MySource.unselected {
    background: #333333; /* Dark gray */
}
Horizontal {
    height: auto;
}
SelectedRichLog { /* Use the new class name */
    border: solid green;
    height: 1fr;
    margin: 1;
}
