    /* Default colors */
    $default-bg: #101010;
    $hw-ish-bg: #2030a0;
    $sw-ish-bg: #20a030;

    .col1v {  width: 20;  }
    .col2v {  width: auto;  }

    /* Layout footer ish */
    Horizontal#footer-outer {
        height: 1;
        width: 1fr;
        dock: bottom;
    }
    Horizontal#footer-inner {
        width: 1fr;
    }
    Label#NameAndClock {
        width: auto;
        color:#808080;
    }

    /* Default layout column1 */
    .col1 {
       width: 18;
       height: 1;
       margin: 0;
       background:#101010;
       border:none;
    }

    #AppTitleBox {
       height: 4;
       color: blue;
       border:round blue;
    }

    #AppTitle {
       color:gold;
       text-align: left;
    }

/*
    #WallClockTime {
       height: 2;
       border:none;
       color:gold;
       text-align: center;
    }
*/
    .hw-ish {
       color: $hw-ish-bg;
    }
    .hw-ish :hover  {
       color:red;
    }
    .sw-ish {
       color:$sw-ish-bg;
    }
    .sw-ish:hover {
       color:red;
    }

    .grid-container { /* A container to hold our grid */
        width: 70%; /* Shrink to fit content horizontally */
        height: auto; /* Shrink to fit content vertically */
        border: round gold; /* Optional: to visualize the container boundaries */
    }

    .bhcv .my-grid { 
        layout: grid;
        grid-size: 17 12; /* fit one complete blackhole card */
        grid-columns: 4 ; /* Each column sizes to its content */
        grid-rows: 1; /* Each row sizes to its content */
        grid-gutter: 0; /* No space between cells */
        border: solid green; /* Optional: to visualize grid boundaries */
    }

    .bh-label {
       width: 27;
       height: 3;
       background:$default-bg;
       text-align: center;
       color:red;
       border:none;
    }

    LogBuf {
        width: 27;
        height: 1fr;
        padding: 1 1;
        background: black;
        border: $secondary tall; 
        content-align: left top;
    }

    .my-grid Label {
        color: grey;
        background: #101010;
        color: white;
        text-align: right;
        content-align: center middle;
        width: 4; /* Give labels a fixed width */
        height: 1; /* Give labels a fixed height */
        &.T {
            color: green;
        }
        &.D {
            color: #404040;
        }
        &.E {
            color: #404040;
        }
        &.C {
            color: #404060;
        }
        &.S {
            color: #604040;
        }
        &.A {
            color: #604040;
        }
        &.P {
            color: #406040;
        }
    }

