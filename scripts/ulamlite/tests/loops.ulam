// loops.ulam -- TEST ONLY: while, for, break, continue, nested loops,
// && || ! in conditions, comparisons as values.  Results: r0..r4.
element TLoops {
  Unsigned(16) r0;
  Unsigned(16) r1;
  Unsigned(16) r2;
  Unsigned(16) r3;
  Unsigned(16) r4;

  Void behave() {
    Unsigned c = 0;
    for (Unsigned i = 0; i < 20; i++)
      if ((i < 3 || i >= 17) && !(i == 18)) c++;
    r0 = c;                             // 0 1 2 17 19: 5

    Unsigned n = 0;
    while (true) {
      n++;
      if (n == 7) break;
    }
    r1 = n;                             // 7

    Unsigned s = 0;
    Bool odd = false;
    for (Unsigned i = 1; i <= 9; i++) {
      odd = !odd;
      if (!odd) continue;
      s += i;
    }
    r2 = s;                             // 1+3+5+7+9 = 25

    r3 = (3 <= 3) + (4 != 4) + (5 > 2) + (2 >= 3) + (7 == 7) + (1 < 0);
                                        // 1+0+1+0+1+0 = 3
    Unsigned k = 0;
    for (Unsigned a = 0; a < 4; a++)
      for (Unsigned b = 0; b < 10; b++) {
        if (b == 2) break;              // the inner loop only
        k++;
      }
    r4 = k;                             // 4 x 2 = 8
  }
}
