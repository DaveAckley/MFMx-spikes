; fb1.bp -- FB1 in BytePhys bytecode: the same steps and the SAME ORDER
; OF RANDOM DRAWS as PHY_FB1 in srcs/cross/images/ewp/src/Physics.cpp
; (the native test checks that site by site).  Not copied: the one-time
; SPLAT! log mark.  Site 0 is the center (ca).

        push 0          ; ca.mStg[1]++
        push 0
        getf stg1
        push 1
        add
        setf stg1
        push 0          ; if (ca.mStg[0] > 0)
        getf stg0
        jz notcounting
        push 0          ;   --ca.mStg[0]
        push 0
        getf stg0
        push 1
        sub
        setf stg0
        push 0          ;   if (ca.mStg[0] == 0): kabam
        getf stg0
        jnz repro
        push 0          ;   for sn = 0..40
boomloop:
        push 100        ;     if (oneIn(100)) continue  (1% survives)
        onein
        jnz boomskip
        dup             ;     atom sn = empty
        empty
boomskip:
        push 1
        add
        dup
        push 41
        lt
        jnz boomloop
        drop
        halt1           ;   return true
repro:
        push 0          ;   else atom between(5,8) = ca  (Moore!)
        push 5
        push 8
        between
        copy
        jmp move
notcounting:
        push 0          ; else if (ca.mStg[1] >= 21 && oneIn(100000))
        getf stg1
        push 21
        lt
        jnz move
        push 100000
        onein
        jz move
        push 0          ;   ca.mStg[0] = between(5,500)
        push 5
        push 500
        between
        setf stg0
        push 0          ;   ca.mStg[1] += between(1000,10000)
        push 0
        getf stg1
        push 1000
        push 10000
        between
        add
        setf stg1
move:
        push 0          ; atom between(1,4) = ca
        push 1
        push 4
        between
        copy
        halt1           ; return true
