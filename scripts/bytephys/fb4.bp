; fb4.bp -- FB4 in BytePhys bytecode: PHY_FB4 in
; srcs/cross/images/ewp/src/Physics.cpp (no random draws).  Differs from
; native only in that age saturates instead of wrapping.  Not copied:
; the every-millionth FB4 log mark.

element BFB4 8
  Aging a               ; only a.age is used

        push 0          ; ca.age++  (by quark: any element with an Aging)
        push 0
        getm Aging.age
        push 1
        add
        setm Aging.age
        push 1          ; for sn = 1..40: atom sn = ca
loop:
        push 0
        over
        copy
        push 1
        add
        dup
        push 41
        lt
        jnz loop
        drop
        halt1           ; return true
