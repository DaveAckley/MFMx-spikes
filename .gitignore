# Build Directories
build_cross
srcs/generated_headers
__pycache__

# Compiled Object files
*.slo
*.lo
*.o

# Compiled Dynamic libraries
*.so
*.dylib

# Compiled Static libraries
*.lai
*.la
*.a

# Ignore emacs backup, autosave, and lock files
*~
\#*\#
.\#*
.*\#

# Ignore executables
bin/*

# Ignore build and lib dirs
build
lib/*

# Ignore doxygen-generated output
doc/ref

# Ignore the code log
codelog.txt

# We don't want ppms
*.ppm

# Leave out unofficially '-held' files
*-hold

# eth-seam tool build outputs (e1fwd/build.sh, t6pp/build.sh, g++ in srcs/host/tools)
srcs/host/tools/e1fwd/*.bin
srcs/host/tools/e1fwd/*.elf
srcs/host/tools/e1fwd/*.dis
srcs/host/tools/t6pp/*.bin
srcs/host/tools/t6pp/*.elf
srcs/host/tools/t6pp/*.dis
srcs/host/tools/ethfwd[0-9]*
!srcs/host/tools/ethfwd[0-9]*.cpp
